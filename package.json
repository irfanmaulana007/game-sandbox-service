{
  "name": "game-sandbox-server",
  "version": "1.0.0",
  "description": "Backend service for Game Sandbox - A comprehensive RPG game with character progression, battle system, and equipment management",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "db:generate": "prisma generate",
    "types:generate": "./scripts/setup-shared-types.sh",
    "types:prepare": "echo 'Use npm run types:generate instead'",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node src/database/faker-seeder.ts",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "postman:generate": "node postman-collection-generator.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint src/**/*.ts --ext .ts",
    "lint:fix": "eslint src/**/*.ts --ext .ts --fix",
    "lint:check": "eslint src/**/*.ts --ext .ts --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\"",
    "code:check": "npm run lint:check && npm run format:check",
    "code:fix": "npm run lint:fix && npm run format"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irfanmaulana007/game-sandbox-service.git"
  },
  "keywords": [
    "game",
    "rpg",
    "backend",
    "express",
    "typescript",
    "postgresql"
  ],
  "author": "Irfan Maulana",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/irfanmaulana007/game-sandbox-service/issues"
  },
  "homepage": "https://github.com/irfanmaulana007/game-sandbox-service#readme",
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "pg": "^8.16.3",
    "redis": "^5.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/redis": "^4.0.10",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "^6.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
