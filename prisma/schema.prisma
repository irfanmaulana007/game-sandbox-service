// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "../shared-types"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  characters Character[]

  @@map("users")
}

model JobClass {
  id               Int     @id @default(autoincrement())
  name             String  @unique
  description      String?
  baseHealth       Int     @map("base_health")
  baseAttack       Int     @map("base_attack")
  baseDefense      Int     @map("base_defense")
  baseSpeed        Int     @map("base_speed")
  baseCritical     Int     @map("base_critical")
  healthPerLevel   Int     @default(10) @map("health_per_level")
  attackPerLevel   Int     @default(1) @map("attack_per_level")
  defensePerLevel  Int     @default(1) @map("defense_per_level")
  speedPerLevel    Int     @default(1) @map("speed_per_level")
  criticalPerLevel Int     @default(1) @map("critical_per_level")

  // Relations
  characters Character[]

  @@map("job_classes")
}

model Character {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  name         String
  jobId        Int      @map("job_id")
  level        Int      @default(1)
  experience   Int      @default(0)
  health       Int
  maxHealth    Int      @map("max_health")
  attack       Int
  defense      Int
  speed        Int
  critical     Int
  statusPoints Int      @default(0) @map("status_points")
  gold         Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  job        JobClass             @relation(fields: [jobId], references: [id])
  equipment  CharacterEquipment[]
  inventory  CharacterInventory[]
  battleLogs BattleLog[]

  @@unique([userId, name])
  @@map("characters")
}

model Equipment {
  id            Int           @id @default(autoincrement())
  name          String
  type          EquipmentType
  rarity        Rarity
  minLevel      Int           @default(1) @map("min_level")
  healthBonus   Int           @default(0) @map("health_bonus")
  attackBonus   Int           @default(0) @map("attack_bonus")
  defenseBonus  Int           @default(0) @map("defense_bonus")
  speedBonus    Int           @default(0) @map("speed_bonus")
  criticalBonus Int           @default(0) @map("critical_bonus")
  description   String?
  dropRate      Decimal       @default(0.0100) @map("drop_rate") @db.Decimal(5, 4)
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  characterEquipment CharacterEquipment[]

  @@map("equipment")
}

model CharacterEquipment {
  id          String        @id @default(cuid())
  characterId String        @map("character_id")
  equipmentId Int           @map("equipment_id")
  slot        EquipmentSlot
  equippedAt  DateTime      @default(now()) @map("equipped_at")

  // Relations
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@map("character_equipment")
}

model Item {
  id          Int      @id @default(autoincrement())
  name        String
  type        String
  description String?
  effectValue Int?     @map("effect_value")
  rarity      Rarity
  dropRate    Decimal  @default(0.0100) @map("drop_rate") @db.Decimal(5, 4)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  characterInventory CharacterInventory[]

  @@map("items")
}

model CharacterInventory {
  id          String   @id @default(cuid())
  characterId String   @map("character_id")
  itemId      Int      @map("item_id")
  quantity    Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id])

  @@map("character_inventory")
}

model GameMap {
  id              Int           @id @default(autoincrement())
  name            String
  description     String?
  minLevel        Int           @default(1) @map("min_level")
  maxLevel        Int           @default(99) @map("max_level")
  difficulty      MapDifficulty
  backgroundImage String?       @map("background_image")
  createdAt       DateTime      @default(now()) @map("created_at")

  // Relations
  monsters Monster[]

  @@map("maps")
}

model Monster {
  id               Int      @id @default(autoincrement())
  name             String
  level            Int      @default(1)
  health           Int
  attack           Int
  defense          Int
  speed            Int
  critical         Int
  experienceReward Int      @default(0) @map("experience_reward")
  goldReward       Int      @default(0) @map("gold_reward")
  mapId            Int?     @map("map_id")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  map        GameMap?        @relation(fields: [mapId], references: [id])
  details    MonsterDetails?
  battleLogs BattleLog[]

  @@map("monsters")
}

model MonsterDetails {
  id          Int         @id @default(autoincrement())
  monsterId   Int         @unique @map("monster_id")
  rank        MonsterRank
  description String?
  imageUrl    String?     @map("image_url")
  dropTable   Json?       @map("drop_table")
  createdAt   DateTime    @default(now()) @map("created_at")

  // Relations
  monster Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)

  @@map("monster_details")
}

model BattleLog {
  id                       String       @id @default(cuid())
  characterId              String       @map("character_id")
  monsterId                Int          @map("monster_id")
  battleResult             BattleResult
  characterHealthRemaining Int          @map("character_health_remaining")
  monsterHealthRemaining   Int          @map("monster_health_remaining")
  turnsTaken               Int          @map("turns_taken")
  experienceGained         Int          @map("experience_gained")
  goldGained               Int          @map("gold_gained")
  battleDate               DateTime     @default(now()) @map("battle_date")

  // Relations
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  monster   Monster   @relation(fields: [monsterId], references: [id])

  @@map("battle_logs")
}

// Enums
enum EquipmentType {
  weapon
  armor
  accessory
}

enum EquipmentSlot {
  weapon
  armor
  accessory1
  accessory2
}

enum Rarity {
  common
  uncommon
  rare
  epic
  legendary
}

enum MapDifficulty {
  easy
  normal
  hard
  extreme
}

enum MonsterRank {
  normal
  elite
  boss
  legendary
}

enum BattleResult {
  victory
  defeat
}
