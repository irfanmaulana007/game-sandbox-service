// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String   @unique
  password_hash String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  characters Character[]

  @@map("users")
}

model JobClass {
  id                 Int     @id @default(autoincrement())
  name               String  @unique
  description        String?
  base_health        Int
  base_attack        Int
  base_defense       Int
  base_speed         Int
  base_critical      Int
  health_per_level   Int     @default(10)
  attack_per_level   Int     @default(1)
  defense_per_level  Int     @default(1)
  speed_per_level    Int     @default(1)
  critical_per_level Int     @default(1)

  // Relations
  characters Character[]

  @@map("job_classes")
}

model Character {
  id            String   @id @default(cuid())
  user_id       String
  name          String
  job_id        Int
  level         Int      @default(1)
  experience    Int      @default(0)
  health        Int
  max_health    Int
  attack        Int
  defense       Int
  speed         Int
  critical      Int
  status_points Int      @default(0)
  gold          Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  user       User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  job        JobClass             @relation(fields: [job_id], references: [id])
  equipment  CharacterEquipment[]
  inventory  CharacterInventory[]
  battleLogs BattleLog[]

  @@unique([user_id, name])
  @@map("characters")
}

model Equipment {
  id             Int           @id @default(autoincrement())
  name           String
  type           EquipmentType
  rarity         Rarity
  min_level      Int           @default(1)
  health_bonus   Int           @default(0)
  attack_bonus   Int           @default(0)
  defense_bonus  Int           @default(0)
  speed_bonus    Int           @default(0)
  critical_bonus Int           @default(0)
  description    String?
  drop_rate      Decimal       @default(0.0100) @db.Decimal(5, 4)
  created_at     DateTime      @default(now())

  // Relations
  characterEquipment CharacterEquipment[]

  @@map("equipment")
}

model CharacterEquipment {
  id           String        @id @default(cuid())
  character_id String
  equipment_id Int
  slot         EquipmentSlot
  equipped_at  DateTime      @default(now())

  // Relations
  character Character @relation(fields: [character_id], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipment_id], references: [id])

  @@map("character_equipment")
}

model Item {
  id           Int      @id @default(autoincrement())
  name         String
  type         String
  description  String?
  effect_value Int?
  rarity       Rarity
  drop_rate    Decimal  @default(0.0100) @db.Decimal(5, 4)
  created_at   DateTime @default(now())

  // Relations
  characterInventory CharacterInventory[]

  @@map("items")
}

model CharacterInventory {
  id           String   @id @default(cuid())
  character_id String
  item_id      Int
  quantity     Int      @default(1)
  created_at   DateTime @default(now())

  // Relations
  character Character @relation(fields: [character_id], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [item_id], references: [id])

  @@map("character_inventory")
}

model GameMap {
  id               Int           @id @default(autoincrement())
  name             String
  description      String?
  min_level        Int           @default(1)
  max_level        Int           @default(99)
  difficulty       MapDifficulty
  background_image String?
  created_at       DateTime      @default(now())

  // Relations
  map_zones GameMapZone[]

  @@map("maps")
}

model GameMapZone {
  id          Int      @id @default(autoincrement())
  map_id      Int
  name        String
  description String?
  created_at  DateTime @default(now())

  // Relations
  map              GameMap          @relation(fields: [map_id], references: [id])
  monsters_details MonsterDetails[]

  @@map("map_zones")
}

model MonsterDetails {
  id          Int      @id @default(autoincrement())
  map_zone_id Int?
  name        String
  description String?
  image_url   String?
  drop_table  Json?
  created_at  DateTime @default(now())

  // Relations
  map_zone GameMapZone? @relation(fields: [map_zone_id], references: [id])
  monsters Monster[]

  @@map("monster_details")
}

model Monster {
  id                Int         @id @default(autoincrement())
  monster_detail_id Int
  rank              MonsterRank
  level             Int         @default(1)
  health            Int
  attack            Int
  defense           Int
  speed             Int
  critical          Int
  experience_reward Int         @default(0)
  gold_reward       Int         @default(0)
  created_at        DateTime    @default(now())

  // Relations
  monster_detail MonsterDetails @relation(fields: [monster_detail_id], references: [id], onDelete: Cascade)
  battleLogs     BattleLog[]

  @@map("monsters")
}

model BattleLog {
  id                         String       @id @default(cuid())
  character_id               String
  monster_id                 Int
  battleResult               BattleResult
  character_health_remaining Int
  monster_health_remaining   Int
  turns_taken                Int
  experience_gained          Int
  gold_gained                Int
  battle_date                DateTime     @default(now())

  // Relations
  character        Character          @relation(fields: [character_id], references: [id], onDelete: Cascade)
  monster          Monster            @relation(fields: [monster_id], references: [id])
  battleLogDetails BattleLogDetails[]

  @@map("battle_logs")
}

enum BattleLogDetailType {
  information
  damage_dealt
  damage_received
  reward
}

model BattleLogDetails {
  id            String              @id @default(cuid())
  battle_log_id String
  message       String
  type          BattleLogDetailType
  created_at    DateTime            @default(now())

  // Relations
  battleLog BattleLog @relation(fields: [battle_log_id], references: [id], onDelete: Cascade)

  @@map("battle_log_details")
}

model ExperienceLevel {
  id         Int      @id @default(autoincrement())
  level      Int      @unique
  experience Int
  created_at DateTime @default(now())

  @@map("experience_levels")
}

// Enums
enum EquipmentType {
  weapon
  armor
  accessory
}

enum EquipmentSlot {
  weapon
  armor
  accessory1
  accessory2
}

enum Rarity {
  common
  uncommon
  rare
  epic
  legendary
}

enum MapDifficulty {
  easy
  normal
  hard
  extreme
}

enum MonsterRank {
  normal
  elite
  boss
  legendary
}

enum BattleResult {
  victory
  defeat
}
